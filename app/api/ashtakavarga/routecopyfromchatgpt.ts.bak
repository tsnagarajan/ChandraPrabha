// app/api/ashtakavarga/route.ts
import { NextResponse } from 'next/server';

type Planet7 = 'Sun' | 'Moon' | 'Mars' | 'Mercury' | 'Jupiter' | 'Venus' | 'Saturn';
const P7: Planet7[] = ['Sun', 'Moon', 'Mars', 'Mercury', 'Jupiter', 'Venus', 'Saturn'];

// Classical multipliers (used in Pinda Sadhana)
const RASI_MULT: number[] = [7, 10, 8, 4, 10, 5, 7, 8, 9, 5, 11, 12]; // Aries..Pisces :contentReference[oaicite:2]{index=2}
const GRAHA_MULT: Record<Planet7, number> = {
  Sun: 5,
  Moon: 5,
  Mars: 8,
  Mercury: 5,
  Jupiter: 10,
  Venus: 7,
  Saturn: 5,
}; // :contentReference[oaicite:3]{index=3}



type Input = {
  positions: Record<string, number>;
  ascendant: number; // degrees 0..360
};



type Output = {
  // 12 signs, index 0..11 = Aries..Pisces
  sav: number[];
  // BAV rows for 7 planets
  bav: Record<Planet7, number[]>;
  // Optional: Lagna (Ascendant) BAV row (computed "from Sun..Saturn")
  lagnaBav: number[];
  // NEW: Sarvashtakavarga classical table
  savTable: SavRow[];

  // NEW: Planet totals + grand total
  savTotals: SavTotals;
  pindas: Record<Planet7, { rasiPinda: number; grahaPinda: number; yogaPinda: number }>;

  // debug (optional)
  debug?: {
    usedRefs: Record<string, number>;
  };
};

// Sarvashtakavarga table row (one sign)
type SavRow = {
  signIndex: number;  // 0..11 (Aries..Pisces)
  Sun: number;
  Moon: number;
  Mars: number;
  Mercury: number;
  Jupiter: number;
  Venus: number;
  Saturn: number;
  Total: number;      // SAV for that sign
};

// Totals row (planet-wise + grand total)
type SavTotals = {
  Sun: number;
  Moon: number;
  Mars: number;
  Mercury: number;
  Jupiter: number;
  Venus: number;
  Saturn: number;
  Total: number;      // should be 337
};




function norm360(x: number): number {
  const v = x % 360;
  return v < 0 ? v + 360 : v;
}
function lonToSignIndex(lon: number): number {
  return Math.floor(norm360(lon) / 30); // 0..11
}

/**
 * RULES[target][ref] = list of HOUSE numbers (1..12) from REF sign
 * where ref contributes a bindu for TARGET's BAV.
 *
 * Source lists: "Planets Benefic Positions For From SUN MOON MARS MERCURY JUPITER VENUS SATURN"
 * and "Asc/Lagna ..." row. :contentReference[oaicite:2]{index=2}
 */
const RULES: Record<Planet7, Record<Planet7, number[]>> = {
  Sun: {
    Sun:     [1,2,4,7,8,9,10,11],
    Moon:    [3,6,7,8,10,11],
    Mars:    [3,5,6,10,11],
    Mercury: [5,6,9,11,12],
    Jupiter: [1,2,3,4,7,8,9,10,11],
    Venus:   [8,11,12],
    Saturn:  [1,2,4,7,8,10,11],
  },
  Moon: {
    Sun:     [3,6,10,11],
    Moon:    [1,3,6,7,10,11],
    Mars:    [3,6,11],
    Mercury: [2,4,6,8,10,11],
    Jupiter: [2,5,7,9,11],
    Venus:   [1,2,3,4,5,8,9,11,12],
    Saturn:  [3,6,11],
  },
  Mars: {
    Sun:     [1,2,4,7,8,9,10,11],
    Moon:    [2,3,5,6,9,10,11],
    Mars:    [1,2,4,7,8,10,11],
    Mercury: [1,2,4,7,8,9,10,11],
    Jupiter: [1,2,4,7,8,10,11],
    Venus:   [3,5,6,9,11,12],
    Saturn:  [3,5,6,10,11,12],
  },
  Mercury: {
    Sun:     [3,5,6,9,10,11,12],
    Moon:    [1,3,4,5,7,8,10,11],
    Mars:    [3,5,6,11],
    Mercury: [1,3,5,6,9,10,11,12],
    Jupiter: [1,2,4,5,6,9,10,11],
    Venus:   [3,5,6,9,11],
    Saturn:  [6,8,9,10,11,12],
  },
  Jupiter: {
    Sun:     [5,6,9,11],
    Moon:    [1,4,7,8,10,11,12],
    Mars:    [6,10,11,12],
    Mercury: [6,8,11,12],
    Jupiter: [1,2,3,4,7,8,10,11],
    Venus:   [5,8,9,10,11],
    Saturn:  [5,6,11,12],
  },
  Venus: {
    Sun:     [6,7,12],
    Moon:    [3,4,5,7,9,10,11],
    Mars:    [6,8,11,12],
    Mercury: [1,2,3,4,5,8,9,11],
    Jupiter: [2,5,6,9,10,11],
    Venus:   [1,2,3,4,5,8,9,10,11],
    Saturn:  [6,11,12],
  },
  Saturn: {
    Sun:     [1,2,4,7,8,9,10,11],
    Moon:    [3,5,6,11],
    Mars:    [1,4,7,8,9,10,11],
    Mercury: [1,2,4,7,8,9,10,11],
    Jupiter: [3,5,6,12],
    Venus:   [3,4,5,8,9,10,11],
    Saturn:  [3,5,6,11],
  },
};

const LAGNA_RULES_FROM_P7: Record<Planet7, number[]> = {
  Sun:     [3,4,6,10,11,12],
  Moon:    [3,6,10,11],
  Mars:    [1,3,6,10,11],
  Mercury: [1,2,4,6,8,10,11],
  Jupiter: [1,2,4,5,6,7,9,10,11],
  Venus:   [1,2,3,4,5,8,9,11],
  Saturn:  [1,3,4,6,10,11],
};

function computeBavForTarget(
  target: Planet7,
  refSigns: Record<Planet7, number>
): number[] {
  const out = Array(12).fill(0);

  for (const ref of P7) {
    const refSign = refSigns[ref];
    const houses = RULES[target][ref];
    for (const h of houses) {
      const idx = (refSign + (h - 1)) % 12;
      out[idx] += 1;
    }
  }

  return out;
}

function computeLagnaBav(refSigns: Record<Planet7, number>): number[] {
  const out = Array(12).fill(0);
  for (const ref of P7) {
    const refSign = refSigns[ref];
    const houses = LAGNA_RULES_FROM_P7[ref];
    for (const h of houses) {
      const idx = (refSign + (h - 1)) % 12;
      out[idx] += 1;
    }
  }
  return out;
}

// Final Sarvashtakavarga should include Lagna bindus in the per-sign totals
const savWithLagna = sav.map((v, i) => v + (lagnaBav?.[i] ?? 0));






export async function POST(req: Request) {
  try {
    const body = (await req.json()) as Partial<Input>;

    if (!body || !body.positions || typeof body.ascendant !== 'number') {
      return NextResponse.json({ error: 'Invalid payload. Expected {positions, ascendant}.' }, { status: 400 });
    }

    // Build ref sign map (Sun..Saturn)
    const refSigns: Record<Planet7, number> = {
      Sun: lonToSignIndex(body.positions.Sun),
      Moon: lonToSignIndex(body.positions.Moon),
      Mars: lonToSignIndex(body.positions.Mars),
      Mercury: lonToSignIndex(body.positions.Mercury),
      Jupiter: lonToSignIndex(body.positions.Jupiter),
      Venus: lonToSignIndex(body.positions.Venus),
      Saturn: lonToSignIndex(body.positions.Saturn),
    };

    // Compute BAV for each planet
    const bav: Output['bav'] = {
      Sun: computeBavForTarget('Sun', refSigns),
      Moon: computeBavForTarget('Moon', refSigns),
      Mars: computeBavForTarget('Mars', refSigns),
      Mercury: computeBavForTarget('Mercury', refSigns),
      Jupiter: computeBavForTarget('Jupiter', refSigns),
      Venus: computeBavForTarget('Venus', refSigns),
      Saturn: computeBavForTarget('Saturn', refSigns),
    };

    // SAV = sum of 7 BAV rows (sign-wise)
    const sav = Array(12).fill(0);
    for (const p of P7) {
      for (let i = 0; i < 12; i++) sav[i] += bav[p][i];
    }

    // Optional Lagna BAV row
    const lagnaBav = computeLagnaBav(refSigns);

    // Build Sarvashtakavarga table (Signs × Planets + Total)
const savTable: SavRow[] = Array.from({ length: 12 }, (_, i) => ({
  signIndex: i,
  Sun: bav.Sun[i],
  Moon: bav.Moon[i],
  Mars: bav.Mars[i],
  Mercury: bav.Mercury[i],
  Jupiter: bav.Jupiter[i],
  Venus: bav.Venus[i],
  Saturn: bav.Saturn[i],
  Total: savWithLagna[i],

}));

// Planet totals + Grand total (should be 337)
const savTotals: SavTotals = {
  Sun: bav.Sun.reduce((a, b) => a + b, 0),
  Moon: bav.Moon.reduce((a, b) => a + b, 0),
  Mars: bav.Mars.reduce((a, b) => a + b, 0),
  Mercury: bav.Mercury.reduce((a, b) => a + b, 0),
  Jupiter: bav.Jupiter.reduce((a, b) => a + b, 0),
  Venus: bav.Venus.reduce((a, b) => a + b, 0),
  Saturn: bav.Saturn.reduce((a, b) => a + b, 0),
  Total: savWithLagna.reduce((a, b) => a + b, 0),

};

// Natal sign indices (needed for Graha Pinda)
const natalSign: Record<Planet7, number> = {
  Sun: lonToSignIndex(body.positions.Sun),
  Moon: lonToSignIndex(body.positions.Moon),
  Mars: lonToSignIndex(body.positions.Mars),
  Mercury: lonToSignIndex(body.positions.Mercury),
  Jupiter: lonToSignIndex(body.positions.Jupiter),
  Venus: lonToSignIndex(body.positions.Venus),
  Saturn: lonToSignIndex(body.positions.Saturn),
};

// Compute Pindas for each planet using current BAV
const pindas: Record<Planet7, { rasiPinda: number; grahaPinda: number; yogaPinda: number }> =
  {} as any;

for (const p of P7) {
  const row = bav[p]; // 12 signs

  // Rasi Pinda = Σ (bindus_in_sign × rasi_multiplier_of_sign)
  const rasiPinda = row.reduce((sum, b, signIdx) => sum + b * RASI_MULT[signIdx], 0);

  // Graha Pinda = Σ (bindus_in_sign_of_each_graha × graha_multiplier_of_that_graha)
  // (Using the BAV row of planet 'p', sampled at natal positions of the 7 planets)
  const grahaPinda = (P7 as Planet7[]).reduce((sum, q) => {
    const signIdx = natalSign[q];
    return sum + row[signIdx] * GRAHA_MULT[q];
  }, 0);

  const yogaPinda = rasiPinda + grahaPinda;

  pindas[p] = { rasiPinda, grahaPinda, yogaPinda };
}


const out: Output = {
      sav: savWithLagna,
      bav,
      lagnaBav,
      savTable,
      savTotals,
      pindas,
      debug: {
        usedRefs: {
          ...Object.fromEntries(P7.map((p) => [p, refSigns[p]])),
          Lagna: lonToSignIndex(body.ascendant),
        },
      },
    };

    return NextResponse.json(out);
  } catch (e: any) {
    return NextResponse.json(
      { error: 'Ashtakavarga computation failed', details: String(e?.message ?? e) },
      { status: 500 }
    );
  }
}
