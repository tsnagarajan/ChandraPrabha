import { ChartOut } from './types'; // adjust the path if needed

export type ChartSummary = {
  bigThree: {
    ascendant: string;
    sun: string;
    moon: string;
  };
  strengths: string[];
  uniqueNote?: string;
  yogas: string[];
};

export function generateSummary(out: ChartOut): ChartSummary {
  const ascSign = getSignName(out.ascendant);
  const sunSign = getSignName(out.positions['Sun']);
  const moonSign = getSignName(out.positions['Moon']);

  const bigThree = {
    ascendant: getLagnaSummary(ascSign),
    sun: `Sun in ${sunSign} — vitality, purpose, and core identity.`,
    moon: `Moon in ${moonSign} — emotional tone and inner world.`,
  };

  const strengths: string[] = [];

  const planetList = ['Sun','Moon','Mars','Mercury','Jupiter','Venus','Saturn'];
  for (const planet of planetList) {
    const deg = out.positions[planet];
    if (deg !== undefined && isInOwnOrExalted(planet, deg)) {
      strengths.push(`Strong ${planet} — may reflect dignity, clarity, or expressive gifts.`);
    }
  }

  const uniqueNote = detectRareAspect(out); // we’ll add this function next
  const yogas: string[] = []; // placeholder for now

  return { bigThree, strengths, uniqueNote, yogas };
}

export const detectRareAspect = (out: ChartOut): string | undefined => {
  const sun = out.positions['Sun'];
  const moon = out.positions['Moon'];
  if (sun !== undefined && moon !== undefined) {
    const angle = Math.abs(sun - moon) % 360;
    if (angle > 85 && angle < 95) {
      return 'Sun and Moon are nearly square — may reflect inner tension and creative drive.';
    }
    if (angle > 175 && angle < 185) {
      return 'Sun and Moon are nearly opposite — may reflect emotional depth and duality.';
    }
    if (angle > 265 && angle < 275) {
      return 'Sun and Moon are nearly trine — may reflect inner harmony and emotional clarity.';
    }
  }
  return undefined;
};